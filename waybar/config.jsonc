// Waybar config for sway — icons limited to Font Awesome 4.7 (Ubuntu 24.04's
// fonts-font-awesome), so nothing falls back to CJK glyphs.
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 2,

    "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad"],
    "modules-center": ["sway/window"],
    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "backlight",
        "network",
        "bluetooth",
        "cpu",
        "memory",
        "temperature",
        "sway/language",
        "battery",
        "clock",
        "tray"
    ],

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": false
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": " {count}",
        "show-empty": false,
        "tooltip-format": "{app}: {title}"
    },
    "sway/window": {
        "max-length": 60
    },

    // Click: keep the screen awake (no lock / blanking)
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" },
        "tooltip-format-activated": "Blocco schermo disattivato",
        "tooltip-format-deactivated": "Blocco schermo attivo"
    },

    // Scroll: volume · click: mute · right click: audio settings
    "pulseaudio": {
        "format": "{icon} {volume}%  {format_source}",
        "format-muted": " muto  {format_source}",
        "format-bluetooth": " {icon} {volume}%  {format_source}",
        "format-bluetooth-muted": "  muto  {format_source}",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pavucontrol || env XDG_CURRENT_DESKTOP=GNOME gnome-control-center sound"
    },

    // Scroll: brightness
    "backlight": {
        "format": " {percent}%",
        "tooltip-format": "Luminosità schermo",
        "on-scroll-up": "brightnessctl -q set 5%+",
        "on-scroll-down": "brightnessctl -q -n 1% set 5%-"
    },

    // Click: network connections editor
    "network": {
        "format-wifi": " {essid} ({signalStrength}%)",
        "format-ethernet": " cavo",
        "format-linked": " nessun IP",
        "format-disconnected": " offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\n {bandwidthDownBytes}   {bandwidthUpBytes}",
        "max-length": 30,
        "on-click": "nm-connection-editor"
    },

    // Click: Blueman device manager
    "bluetooth": {
        "format": "",
        "format-disabled": " off",
        "format-off": " off",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}: {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },

    // Click: system monitor
    "cpu": {
        "format": " {usage}%",
        "tooltip-format": "CPU",
        "interval": 3,
        "on-click": "gnome-system-monitor"
    },
    "memory": {
        "format": " {percentage}%",
        "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB",
        "interval": 5,
        "on-click": "gnome-system-monitor"
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "Temperatura CPU"
    },

    "sway/language": {
        "format": " {short}",
        "tooltip-format": "{long}"
    },

    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-full": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}"
    },

    // Click: toggle date
    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%a %d/%m/%Y  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": { "mode": "month", "weeks-pos": "left", "on-scroll": 1 }
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
