# Sway config — MSI GS66 Stealth (i7-12xxxH / RTX 3070 Ti, 15.6" QHD 240 Hz)
#
# Read `man 5 sway` for a complete reference.
# Original default config saved as config.bak-<date> in this directory.
#
# Optional packages this config uses (Ubuntu 24.04):
#   sudo apt install brightnessctl playerctl slurp mako-notifier wlsunset kanshi \
#                    xdg-desktop-portal-wlr policykit-1-gnome cliphist blueman
# Anything not installed just silently does nothing.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Terminal and launcher
set $term foot
set $menu wofi --show drun --insensitive --allow-images | xargs swaymsg exec --
set $run  wofi --show run --insensitive | xargs swaymsg exec --
# Lock screen
set $lock swaylock -f -c 1e1e2e --indicator-radius 80 --show-failed-attempts

# Outputs (used by the lid switch and workspace placement).
# $external is matched by model, so on other machines it simply doesn't exist
# and every workspace falls back to the laptop panel.
set $laptop eDP-1
set $external "LG Electronics LG ULTRAWIDE 0x00054C91"

include /etc/sway/config-vars.d/*

### Look & feel
#
font pango:Noto Sans 10
default_border pixel 2
default_floating_border pixel 2
titlebar_border_thickness 1
titlebar_padding 6 3
hide_edge_borders --i3 smart
smart_gaps on
gaps inner 6
gaps outer 0

# class                 border  backgr. text    indicator child_border
client.focused          #89b4fa #89b4fa #1e1e2e #f5c2e7   #89b4fa
client.focused_inactive #45475a #45475a #cdd6f4 #45475a   #45475a
client.unfocused        #313244 #1e1e2e #a6adc8 #313244   #313244
client.urgent           #f38ba8 #f38ba8 #1e1e2e #f38ba8   #f38ba8

focus_follows_mouse yes
mouse_warping container
workspace_auto_back_and_forth yes
focus_on_window_activation smart

### Output configuration
#
# Per-monitor mode/scale/position lives in kanshi.conf (profiles matched by
# monitor model, so this file works unchanged on any machine).
# kanshi is restarted on every reload so it re-applies its profile.
exec_always sh -c 'pkill -x kanshi; exec kanshi -c ~/.config/sway/kanshi.conf' 

output * bg /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png fill

# Lid closed with an external monitor → disable the internal panel.
# (Without an external monitor, logind suspends as usual.)
bindswitch --reload --locked lid:on  output $laptop disable
bindswitch --reload --locked lid:off output $laptop enable

### Idle configuration
#
# Lock after 5 min, screens off after 10, lock before suspend.
exec swayidle -w \
    timeout 300 '$lock' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '$lock'

# Don't lock/blank while something is fullscreen (videos, games)
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen

### Input configuration
#
# Italian layout. Caps Lock as an extra Escape is handy with vim; remove
# `caps:escape` if you don't want it.
input type:keyboard {
    xkb_layout it
    xkb_model pc105
    xkb_options caps:escape
    repeat_delay 250
    repeat_rate 40
    xkb_numlock enabled
}

# Synaptics/HID touchpad (06CB:CDAA)
input type:touchpad {
    tap enabled
    tap_button_map lrm
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
    click_method clickfinger
    scroll_method two_finger
    accel_profile adaptive
    pointer_accel 0.2
}

# External mice: flat profile (no acceleration) is usually what you want
input type:pointer {
    accel_profile flat
    pointer_accel 0
}

# Hide cursor after 3 s of inactivity
seat * hide_cursor 3000
seat * hide_cursor when-typing enable

### Key bindings
#
# Basics:
#
    bindsym $mod+Return exec $term
    bindsym $mod+Shift+q kill
    bindsym $mod+d exec $menu
    bindsym $mod+Shift+d exec $run

    # Drag floating windows with $mod + left mouse, resize with $mod + right.
    floating_modifier $mod normal

    bindsym $mod+Shift+c reload
    bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway? This will end your Wayland session.' \
        -B 'Lock' '$lock' \
        -B 'Suspend' 'systemctl suspend' \
        -B 'Reboot' 'systemctl reboot' \
        -B 'Power off' 'systemctl poweroff' \
        -B 'Log out' 'swaymsg exit'

    # Lock screen
    bindsym $mod+Escape exec $lock

    # File manager
    bindsym $mod+n exec nautilus --new-window
#
# Laptop function keys (Fn + F-row) — work on the lock screen too
#
    # Volume (PipeWire)
    bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
    bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
    bindsym --locked XF86AudioMute        exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    bindsym --locked XF86AudioMicMute     exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

    # Brightness (needs brightnessctl)
    bindsym --locked XF86MonBrightnessUp   exec brightnessctl -q set 5%+
    bindsym --locked XF86MonBrightnessDown exec brightnessctl -q -n 1% set 5%-

    # Media (needs playerctl)
    bindsym --locked XF86AudioPlay  exec playerctl play-pause
    bindsym --locked XF86AudioPause exec playerctl play-pause
    bindsym --locked XF86AudioNext  exec playerctl next
    bindsym --locked XF86AudioPrev  exec playerctl previous

    # Touchpad toggle key
    bindsym XF86TouchpadToggle input type:touchpad events toggle enabled disabled
#
# Screenshots (grim + wl-copy; region needs slurp)
#
    # Full screen → clipboard + ~/Pictures/Screenshots
    bindsym Print exec mkdir -p ~/Pictures/Screenshots && \
        grim - | tee ~/Pictures/Screenshots/$(date +%Y%m%d-%H%M%S).png | wl-copy
    # Region → clipboard
    bindsym Shift+Print exec grim -g "$(slurp)" - | wl-copy
    # Focused output → clipboard
    bindsym $mod+Print exec grim -o "$(swaymsg -t get_outputs | jq -r '.[] | select(.focused).name')" - | wl-copy
    # Region with annotation (needs flameshot >= 13 — 12.x breaks with scale 1.25)
    bindsym $mod+Shift+s exec flameshot gui
#
# Moving around:
#
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

    # Cycle workspaces / jump back
    bindsym $mod+Tab workspace back_and_forth
    bindsym $mod+Ctrl+Right workspace next_on_output
    bindsym $mod+Ctrl+Left workspace prev_on_output

    # Multi-monitor: focus / move between outputs
    bindsym $mod+comma focus output left
    bindsym $mod+period focus output right
    bindsym $mod+Ctrl+Up focus output up
    bindsym $mod+Ctrl+Down focus output down
    bindsym $mod+Ctrl+Shift+Up move workspace to output up
    bindsym $mod+Ctrl+Shift+Down move workspace to output down
#
# Workspaces:
#
    # 1–5 on the external monitor, 6–10 on the laptop (falls back to whatever
    # output exists when the external one is unplugged)
    workspace 1 output $external $laptop
    workspace 2 output $external $laptop
    workspace 3 output $external $laptop
    workspace 4 output $external $laptop
    workspace 5 output $external $laptop
    workspace 6 output $laptop
    workspace 7 output $laptop
    workspace 8 output $laptop
    workspace 9 output $laptop
    workspace 10 output $laptop

    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10

    bindsym $mod+Shift+1 move container to workspace number 1, workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2, workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3, workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4, workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5, workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6, workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7, workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8, workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9, workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10, workspace number 10
#
# Layout stuff:
#
    bindsym $mod+b splith
    bindsym $mod+v splitv

    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    bindsym $mod+f fullscreen
    bindsym $mod+Shift+space floating toggle
    bindsym $mod+space focus mode_toggle
    bindsym $mod+a focus parent

    # Toggle sticky (floating window visible on every workspace)
    bindsym $mod+Shift+p sticky toggle
    # Toggle gaps
    bindsym $mod+g gaps inner current toggle 6
#
# Scratchpad:
#
    bindsym $mod+Shift+minus move scratchpad
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    bindsym $left resize shrink width 20px
    bindsym $down resize grow height 20px
    bindsym $up resize shrink height 20px
    bindsym $right resize grow width 20px

    bindsym Left resize shrink width 20px
    bindsym Down resize grow height 20px
    bindsym Up resize shrink height 20px
    bindsym Right resize grow width 20px

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

### Window rules
#
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [app_id="pavucontrol"] floating enable, resize set 800 600
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="blueman-manager"] floating enable, resize set 700 500
for_window [app_id="org.gnome.Calculator"] floating enable
for_window [title="(?:Open|Save) (?:File|Folder|As)"] floating enable, resize set 900 600
for_window [title="Picture-in-Picture"] floating enable, sticky enable
for_window [app_id="firefox" title="^Picture-in-Picture$"] floating enable, sticky enable
# Mark XWayland windows in the title so you can spot them
for_window [shell="xwayland"] title_format "%title [X]"

### Status bar
#
# Waybar config and style live in ./waybar (versioned with this repo);
# ~/.config/waybar is a symlink to it: ln -sfn ~/.config/sway/waybar ~/.config/waybar
bar {
    swaybar_command waybar
    position top
}

### Autostart
#
# Make the session environment visible to systemd/dbus (portals, screen sharing)
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway SWAYSOCK DISPLAY

# Secrets (browser/VS Code passwords)
exec gnome-keyring-daemon --start --components=secrets,pkcs11

# Polkit agent (GUI password prompts for admin actions)
exec /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1

# Notifications
exec mako

# Network tray icon
exec nm-applet --indicator

# Bluetooth tray icon; $mod+Shift+b opens the device manager
exec blueman-applet
bindsym $mod+Shift+b exec blueman-manager

# Night light (Rome-ish coordinates; tweak or remove)
exec wlsunset -l 41.9 -L 12.5

# Clipboard history: $mod+c to pick an entry
exec wl-paste --watch cliphist store
bindsym $mod+c exec cliphist list | wofi --dmenu | cliphist decode | wl-copy

include /etc/sway/config.d/*
